# ==============================================================================
# SpectraShield Unified .gitignore
# ==============================================================================

# --- Python & Virtual Environments ---
.venv/
venv/
env/
**/venv/
**/.venv/
backend/.venv/
backend/venv/
backend/app/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# --- Database & Runtime Data ---
*.db
*.sqlite
*.sqlite3
backend/data/quarantine/
data/quarantine/
*.log

# --- Environment & Secret Keys ---
.env
.env.*
!.env.example
*.env.local

# --- Node.js & Frontend Build Artifacts ---
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
package-lock.json.bak
*.tgz

# --- Operating System & IDEs ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# --- Temporary Files, Diffs & Archives ---
*.diff
*.patch
*.7z
*.zip
*.tar
*.tar.gz

# --- Test Outputs & Media Artifacts in Root ---
/*.pdf
/*.png
/*.jpg
/*.jpeg
/*.pptx
/*.ppt

# --- Legacy Backup Directories ---
prev-frontend/