# ==============================================================================
# SpectraShield Unified .gitignore
# ==============================================================================

# --- Python & Virtual Environments ---
.venv/
venv/
env/
**/venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# --- Database & Runtime Data ---
*.db
*.sqlite
*.sqlite3
backend/data/quarantine/
data/quarantine/
*.log

# --- Environment & Secret Keys ---
.env
.env.*
!.env.example
*.env.local
backend/.env
backend/.env.*
!backend/.env.example

# --- Node.js & Frontend Build Artifacts ---
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
package-lock.json
package-lock.json.bak
*.tgz

# --- Operating System & IDEs ---
.DS_Store
Thumbs.db
.vscode/
.idea/
.agents/
*.swp
*~

# --- Archives & Large Binaries ---
*.zip
*.7z
*.tar
*.tar.gz
*.rar

# --- Test Outputs & Scratch Files ---
backend/test_*.pdf
backend/test_*_runner.py
*.pdf
!docs/**/*.pdf

# --- Media & Presentation Artifacts ---
*.png
*.jpg
*.jpeg
*.pptx
*.ppt
!frontend/public/**
!extension/**/*.png
!docs/**/*.png

# --- Temporary & Patch Files ---
*.diff
*.patch
*.bak
*.tmp

# --- Legacy / Scratch Docs ---
clutter.md
declutter.md

# --- Legacy Backup Directories ---
prev-frontend/