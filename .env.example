# ==============================================================================
# SPECTRASHIELD 2.0 — ENVIRONMENT TEMPLATE (.env.example)
# Enterprise Forensics & Threat Attribution Platform
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    - In backend/:  cp .env.example .env
#    - Or in root:   cp .env.example .env
# 2. Fill in your credentials and API keys below.
# 3. For development, default fallback values are provided so the system works
#    out-of-the-box in local offline mode without mandatory external accounts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE ENTERPRISE SECURITY & RBAC (CRITICAL)
# ------------------------------------------------------------------------------
# 256-bit cryptographic secret for signing JWT tokens and session verification.
# In production, NEVER use a default key. Generate a high-entropy secret using:
#   openssl rand -hex 32
# or:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_64_character_hex_secret_generated_by_openssl

# Signing algorithm for JSON Web Tokens (Default: HS256)
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (Default: 15 minutes for strict zero-trust)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (Default: 7 days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo Mode Fallback:
# - Set to "True" for local testing, offline demos, or automated test runners.
#   Unauthenticated requests will gracefully use a default Forensic Analyst profile.
# - Set to "False" for production deployments to strictly reject unauthenticated
#   requests with HTTP 401 Unauthorized.
ALLOW_DEMO_FALLBACK=True


# ------------------------------------------------------------------------------
# 2. PERSISTENCE & DATABASE STORAGE (SUPABASE / POSTGRESQL)
# ------------------------------------------------------------------------------
# Primary database backend: "supabase" (or "postgres").
# When DATABASE_URL is empty or offline, SpectraShield gracefully runs in
# resilient in-memory mode (ideal for quick evaluation and local testing).
DB_BACKEND=supabase

# Supabase / PostgreSQL Connection String
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/spectrashield_db

# Optional Cloud Database Aliases:
# SUPABASE_DB_URL=postgresql://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres
# POSTGRES_URL=postgresql://user:password@hostname:5432/dbname


# ------------------------------------------------------------------------------
# 3. EXTERNAL CYBER THREAT INTELLIGENCE (CTI) FEEDS
# ------------------------------------------------------------------------------
# If left blank, SpectraShield uses its built-in offline heuristic detectors,
# URLhaus live threat feed, and open-source intelligence lookups.

# Google Safe Browsing API v4 Key
# Used for real-time URL reputation, malware, and social engineering threat detection.
# Obtain a free key from: https://console.cloud.google.com/
# (Enable "Safe Browsing APIs" -> APIs & Services -> Credentials -> Create API Key)
GOOGLE_SAFE_BROWSING_API_KEY=

# AbuseIPDB API v2 Key
# Used for real-time relay IP reputation, reporting abuse confidence, and ISP checks.
# Obtain a free key from: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# VirusTotal v3 API Key
# Used for scanning attachment SHA-256 hashes and URL multi-engine consensus.
# Obtain a free key from: https://www.virustotal.com/gui/user/username/apikey
VT_API_KEY=


# ------------------------------------------------------------------------------
# 4. ENTERPRISE THREAT GRAPH & ATTRIBUTION (NEO4J)
# ------------------------------------------------------------------------------
# Used for enterprise multi-campaign actor clustering and cross-tenant graph intelligence.
# If omitted or offline, SpectraShield seamlessly uses an in-memory NetworkX DiGraph
# with Louvain community modularity algorithms.
# Example: bolt://localhost:7687 or neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=


# ------------------------------------------------------------------------------
# 5. AUTOMATED SOC MAILBOX INGESTION (IMAP DAEMON)
# ------------------------------------------------------------------------------
# Enables the background polling daemon to continuously ingest suspicious emails
# from a designated triage mailbox (e.g. phish-triage@organization.com).
# If left blank, mailbox polling remains idle, and manual uploads via REST API/UI work normally.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX


# ------------------------------------------------------------------------------
# 6. APPLICATION SERVER & LOGGING
# ------------------------------------------------------------------------------
# Deployment environment: "development", "staging", or "production"
ENVIRONMENT=development

# Server bind host and port
HOST=0.0.0.0
PORT=8000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
